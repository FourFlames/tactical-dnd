{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 5173
    },
    {
      "name": "viewer-sandbox",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.PORT='5174'; process.env.TDND_DATA='.sandbox'; require('./server.js')"
      ],
      "port": 5174
    },
    {
      "name": "poc",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "require('http').createServer((q,s)=>require('fs').readFile('poc/'+(require('path').basename(q.url.split('?')[0])||'wheel.html'),(e,d)=>{s.writeHead(e?404:200,{'content-type':'text/html; charset=utf-8'});s.end(d)})).listen(5175)"
      ],
      "port": 5175
    }
  ]
}
