{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kernel",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--manifest-path",
        "kernel/Cargo.toml",
        "-p",
        "kernel-server"
      ],
      "port": 5180
    },
    {
      "name": "legacy-viewer",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "legacy/server.js"
      ],
      "port": 5173
    },
    {
      "name": "legacy-sandbox",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.PORT='5174'; process.env.TDND_DATA='legacy/.sandbox'; require('./legacy/server.js')"
      ],
      "port": 5174
    }
  ]
}
